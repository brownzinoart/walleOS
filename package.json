{
  "name": "wallegpt-portfolio",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "analyze": "vite-bundle-analyzer",
    "docs": "typedoc",
    "docs:serve": "typedoc && npx serve docs",
    "performance": "vite-bundle-analyzer dist/assets/*.js",
    "clean": "rm -rf dist .nyc_output coverage",
    "prepare": "node scripts/prepare.mjs",
    "deploy": "npm run prepare && npm run build",
    "warmup:ollama": "bash -c 'ollama serve >/dev/null 2>&1 & sleep 2; ollama pull ${OLLAMA_MODEL:-llama3.1:8b} || true; ollama pull nomic-embed-text || true; echo warming; ollama run ${OLLAMA_MODEL:-llama3.1:8b} \"hi\" >/dev/null 2>&1 || true'",
    "ingest:corpus": "node scripts/run-ingest.mjs",
    "ingest:gemini": "node scripts/run-ingest.mjs --provider gemini",
    "dev:infra": "npm run warmup:ollama && npm run ingest:corpus",
    "dev:all": "concurrently -k -n SERVER,WEB \"npm:dev --prefix server\" \"npm run dev\"",
    "up": "npm run dev:infra && npm run dev:all"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^8.0.3",
    "jsdom": "^23.0.0",
    "lint-staged": "^15.0.2",
    "postcss": "^8.4.0",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.0",
    "vite": "^7.1.9",
    "vite-bundle-analyzer": "^0.7.0",
    "vitest": "^3.2.4",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "locomotive-scroll": "^4.1.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
